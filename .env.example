# Copy to .env (read by Docker Compose and Next.js). Never commit real values.
# With Docker Compose, DATABASE_URL is set for you (the "db" service); the
# POSTGRES_* values below configure that service.

# POSTGRES_USER=gatherly
# POSTGRES_PASSWORD=gatherly   # change for any shared or production deployment
# POSTGRES_DB=gatherly
# POSTGRES_PORT=5432           # host port for the db service (bound to 127.0.0.1)
# APP_PORT=3000                # host port for the web app

# Outside Docker only: PostgreSQL connection string. Leave unset to use the
# embedded PGlite database in .data/pglite (no install needed).
# DATABASE_URL=postgres://gatherly:gatherly@localhost:5432/gatherly
# DATABASE_SSL=false          # "true" for managed providers that require TLS without a CA bundle
# DATABASE_POOL_MAX=10

# Public base URL, used to build invitation links in the UI and emails.
APP_URL=http://localhost:3000

# 32+ random characters. Encrypts stored invitation links so hosts can copy
# them again. Required in production. Changing it makes existing links
# un-copyable (they still work for guests); hosts can issue new links.
# Generate with: openssl rand -base64 48
APP_SECRET=replace-with-at-least-32-random-characters

# Email: "console" (default, logs subject only) or "resend".
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM="Gatherly <invites@your-domain.example>"

# Shared secret for the notification worker endpoint (POST /api/jobs/notifications).
CRON_SECRET=replace-with-a-random-string

# Set to "true" only in tests to bypass rate limiting.
# RATE_LIMIT_DISABLED=false
